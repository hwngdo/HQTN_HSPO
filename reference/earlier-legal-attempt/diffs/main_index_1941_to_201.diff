 function enableColumnResize(id){let t=$(id);if(!t||t.dataset.resizeReady)return;t.dataset.resizeReady='1';t.querySelectorAll('th').forEach((th,i)=>{let key='hspo_col_'+id+'_'+i,w=localStorage.getItem(key);if(w)th.style.width=w+'px';let h=document.createElement('span');h.className='thinner';h.onclick=e=>e.stopPropagation();h.onpointerdown=e=>{e.preventDefault();e.stopPropagation();let sx=e.clientX,sw=th.getBoundingClientRect().width;h.setPointerCapture(e.pointerId);h.onpointermove=ev=>{let nw=Math.max(70,sw+ev.clientX-sx);th.style.width=nw+'px'};h.onpointerup=ev=>{localStorage.setItem(key,Math.round(th.getBoundingClientRect().width));h.releasePointerCapture(ev.pointerId);h.onpointermove=h.onpointerup=null}};th.style.position='sticky';th.appendChild(h)})}function enableSplit(id,key){let box=$(id);if(!box||box.dataset.splitReady)return;let g=box.querySelector('.gutter');if(!g)return;box.dataset.splitReady='1';let saved=localStorage.getItem('hspo_split_'+key);if(saved)setSplit(box,key,+saved);g.onpointerdown=e=>{let rect=box.getBoundingClientRect();g.setPointerCapture(e.pointerId);g.onpointermove=ev=>{let pct=Math.min(78,Math.max(28,(ev.clientX-rect.left)/rect.width*100));setSplit(box,key,pct)};g.onpointerup=ev=>{let pct=parseFloat(box.dataset.pct||'67');localStorage.setItem('hspo_split_'+key,pct);g.releasePointerCapture(ev.pointerId);g.onpointermove=g.onpointerup=null}}}function setSplit(box,key,pct){box.dataset.pct=pct;if(key==='hs')box.style.gridTemplateColumns=`minmax(360px,${pct}fr) 8px minmax(300px,${100-pct}fr)`;else if(key==='tariff')box.style.gridTemplateColumns=`minmax(480px,${pct}fr) 8px minmax(340px,${100-pct}fr)`;else box.style.gridTemplateColumns=`minmax(300px,${pct}fr) 8px minmax(360px,${100-pct}fr)`}
 
 function normText(v){return String(v||'').normalize('NFD').replace(/[\u0300-\u036f]/g,'').toLowerCase().replace(/đ/g,'d').replace(/[^a-z0-9%]+/g,' ').replace(/\s+/g,' ').trim()}function normKeepAccent(v){return String(v||'').normalize('NFC').toLowerCase().replace(/[^\p{L}\p{N}%]+/gu,' ').replace(/\s+/g,' ').trim()}function hasVNAccent(v){let a=normKeepAccent(v),b=normText(v);return a!==b}function tariffAccentTokens(v){return normKeepAccent(v).split(' ').filter(Boolean)}
